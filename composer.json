{
    "name": "good-sender/php-sdk",
    "version": "0.1.0",
    "description": "Official GoodSender API client for PHP",
    "keywords": [
        "goodsender",
        "email",
        "api",
        "sdk",
        "consent",
        "transactional"
    ],
    "homepage": "https://github.com/good-sender/php-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "GoodSender",
            "email": "support@goodsender.com",
            "homepage": "https://goodsender.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "GoodSender\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GoodSender\\Test\\": "test/"
        }
    }
}
